# ── Required ────────────────────────────────────────────────────────────────
# Domain Caddy serves (DNS A/AAAA record must point at the VPS).
SITE_ADDRESS=auth.example.com
# Same domain as a URL; used for CSRF checks and the links in invitations.
PUBLIC_ORIGIN=https://auth.example.com
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com
# Postgres password for the internal database (never exposed outside Docker).
#   openssl rand -base64 24
POSTGRES_PASSWORD=
# ≥ 32 random bytes. Signs access tokens and protects TOTP seeds. Rotating it signs everyone out.
#   openssl rand -base64 48
AUTH_SECRET=

# ── Email (SMTP) — required to invite members ───────────────────────────────
# Invitations are emailed automatically; without SMTP_HOST and SMTP_FROM the
# dashboard refuses to create members. Use your own mail provider's values.
# These stay on the server: they are never part of the iPhone app.
SMTP_HOST=
# 587 with SMTP_SECURE=0 (STARTTLS, required) or 465 with SMTP_SECURE=1 (implicit TLS).
SMTP_PORT=587
SMTP_SECURE=0
# Set both or neither (some relays authenticate by IP).
SMTP_USER=
SMTP_PASSWORD=
# Sender the relay is allowed to use, e.g. "Gym RAT <no-reply@your-domain>".
SMTP_FROM=

# ── Optional ────────────────────────────────────────────────────────────────
POSTGRES_DB=gymrat
POSTGRES_USER=gymrat
OFFLINE_LEASE_DAYS=7
INVITE_TTL_HOURS=72
RESET_TTL_MINUTES=60
