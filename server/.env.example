# ── Required ────────────────────────────────────────────────────────────────
# Domain Caddy serves for the API (DNS A/AAAA record must point at the VPS).
SITE_ADDRESS=api.example.com
# Same domain as a URL; the base of invitation, reset and setup links.
PUBLIC_ORIGIN=https://api.example.com
# Exact origin of the admin dashboard (the admin/ app on Vercel). The only
# origin allowed to call /api/admin/* (CORS + CSRF). Origin only: no path, no
# trailing slash. Must share the registrable domain with PUBLIC_ORIGIN
# (admin.<domain> and api.<domain>) so the SameSite=Strict cookie is sent.
ADMIN_ORIGIN=https://admin.example.com
# Email for Let's Encrypt expiry notices.
ACME_EMAIL=you@example.com
# Postgres password for the internal database (never exposed outside Docker).
#   openssl rand -base64 24
POSTGRES_PASSWORD=
# ≥ 32 random bytes. Signs access tokens and protects TOTP seeds. Rotating it signs everyone out.
#   openssl rand -base64 48
AUTH_SECRET=

# ── Email (SMTP) — required to invite members ───────────────────────────────
# Invitations are emailed automatically; without SMTP_HOST and SMTP_FROM the
# dashboard refuses to create members. These stay on the server: they are never
# part of the iPhone app, the dashboard (Vercel) or Git.
# Provider: Resend's SMTP relay (owner decision 2026-11-03, ADR-019).
SMTP_HOST=smtp.resend.com
# 465 with SMTP_SECURE=1 (implicit TLS). 587 with SMTP_SECURE=0 also works (STARTTLS, required).
SMTP_PORT=465
SMTP_SECURE=1
# Resend: the user is literally "resend"; the password is a Resend API key with
# "Sending access" for the verified domain only. Paste it on the VPS, nowhere else.
SMTP_USER=resend
SMTP_PASSWORD=
# Sender on a domain verified in Resend. See README "Email (SMTP)" for which domain
# the current DNS records verify before choosing the address.
SMTP_FROM=GYM RAT <no-reply@send.quantara-eg.com>
# Language of emails for members without a stored choice: en or ar.
MAIL_DEFAULT_LOCALE=en

# ── Optional ────────────────────────────────────────────────────────────────
POSTGRES_DB=gymrat
POSTGRES_USER=gymrat
OFFLINE_LEASE_DAYS=7
INVITE_TTL_HOURS=72
RESET_TTL_MINUTES=60
