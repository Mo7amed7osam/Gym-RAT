# Gym RAT admin dashboard (ADR-018). The only setting: the API's public origin.
# It is compiled into the browser bundle, so it must never be a secret.
# Origin only (scheme, host, optional port): no path, no trailing slash.
# Production on Vercel: set it for the Production environment only.
#   NEXT_PUBLIC_API_ORIGIN=https://api.<your-domain>
# Local cross-origin testing (see README):
#   NEXT_PUBLIC_API_ORIGIN=http://api.gymrat.localhost:3100
NEXT_PUBLIC_API_ORIGIN=
