{
  "expo": {
    "name": "Gym RAT",
    "slug": "gym-rat",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "gymrat",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.gymrat.app",
      "appleTeamId": "8TBB6SU34J",
      "config": {
        "usesNonExemptEncryption": false
      },
      "buildNumber": "1",
      "infoPlist": {
        "NSHealthUpdateUsageDescription": "Gym RAT saves each finished workout to Apple Health as a strength-training session (start, end and pauses only). It never reads your Health data."
      },
      "entitlements": {
        "com.apple.developer.healthkit": true,
        "com.apple.developer.default-data-protection": "NSFileProtectionCompleteUnlessOpen"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ],
      "expo-asset",
      "expo-sqlite",
      [
        "expo-localization",
        {
          "supportedLocales": {
            "ios": [
              "en",
              "ar"
            ]
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Gym RAT uses your photos to illustrate custom exercises you create.",
          "cameraPermission": "Gym RAT uses the camera to photograph custom exercises you create."
        }
      ],
      [
        "expo-notifications",
        {
          "enableRemoteNotifications": false,
          "enableBackgroundRemoteNotifications": false,
          "sounds": [
            "./assets/sounds/rest-complete.wav"
          ]
        }
      ],
      [
        "expo-widgets",
        {
          "bundleIdentifier": "com.gymrat.app.ExpoWidgetsTarget",
          "groupIdentifier": "group.com.gymrat.app",
          "enablePushNotifications": false,
          "frequentUpdates": false
        }
      ],
      "./plugins/withUnlicensedAssetGuard"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "locales": {
      "en": "./i18n/native/en.json",
      "ar": "./i18n/native/ar.json"
    }
  }
}
